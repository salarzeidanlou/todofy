{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "todofy",
  "version": "1.14.0",
  "identifier": "com.unifybrowse.todofy",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "todofy",
        "width": 800,
        "height": 600,
        "visible": false
      },
      {
        "label": "quickadd",
        "title": "Add Todo",
        "url": "quickadd.html",
        "width": 640,
        "height": 210,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "label": "notification",
        "title": "todofy notification",
        "url": "notification.html",
        "width": 400,
        "height": 170,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "focus": false,
        "visible": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co https://apitodofy.unifybrowse.com https://oauth2.googleapis.com https://www.googleapis.com; font-src 'self'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["todofy"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4QkNERDhFNkM4QzA4MDAKUldRQUNJeHNqdDI4ZUEyak1xWnQ0bWtCd1VoVDVlKzg4OUE5MURtRDF0YUhZZFVkbEdiRE5LQS8K",
      "endpoints": [
        "https://github.com/salarzeidanlou/todofy/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "main.desktop",
        "files": {
          "/usr/share/metainfo/com.unifybrowse.todofy.metainfo.xml": "com.unifybrowse.todofy.metainfo.xml"
        }
      },
      "rpm": {
        "desktopTemplate": "main.desktop",
        "files": {
          "/usr/share/metainfo/com.unifybrowse.todofy.metainfo.xml": "com.unifybrowse.todofy.metainfo.xml"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/metainfo/com.unifybrowse.todofy.metainfo.xml": "com.unifybrowse.todofy.metainfo.xml"
        }
      }
    }
  }
}
