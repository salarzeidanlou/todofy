{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "todofy",
  "version": "1.2.0",
  "identifier": "com.unifybrowse.todofy",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "todofy",
        "width": 800,
        "height": 600
      },
      {
        "label": "quickadd",
        "title": "Add Todo",
        "url": "quickadd.html",
        "width": 640,
        "height": 210,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
